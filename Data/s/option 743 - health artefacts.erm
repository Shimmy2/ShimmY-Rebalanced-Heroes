!!en;

!?FU(ES_AfterVitalityArtifactsBonusesCalculation);        [call function from hook]
  !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EBP)/4/?(ebp:y) C(ebp)/-4/4/?(hero:y);

  !!UN:C(hero)/26/4/?(heroId:y) C(ebp)/8/4/?(monID:y);
  !!MA:X(monID)/?f;
  *!VRf:&(MON_FLAG_ALIVE);
  !!if&f;
    !!if&i^ES_medicine_enabled^;
      !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EAX)/4/?(hp:y);

      !!HE(heroId:y):S(SKILL_FIRST_AID)/?(skillLvl:y) X?(spec:y)/?(skill:y) E?(exp:y)/?(level:y);   [y11 - hero Medicine level [0..3]]
      !if&(skillLvl)/(spec)=0/(skill)=(SKILL_FIRST_AID);
        !VR(skillLvl):+1;
      !en;
      *!UN:Cx1/(STRUCT_HOOK_CONTEXT_EAX)/4/d(skillLvl);    

      !!VR(firstAid:y):S(hp) *(skillLvl) *5;                   /simi

      !!if&(spec)=0/(skill)=(SKILL_FIRST_AID);
        !!VR(specBonus:y):S(firstAid) *(level) :20;
      !!en;
      !!VR(firstAid)&(firstAid)<100/(skillLvl)=3:S100;
      !!VR(firstAidBonus:y):S(firstAid) +(specBonus) :100;
      !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EBX)/4/d(firstAidBonus);
    !!en;

    !!if&i^ES_health_artifacts_enabled^;
      !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EAX)/4/?h;

      !!HE(heroId):A2/131/?y99/?(elix:y);

      !!if&(elix);S
        !!VR(bonus:y):S5;
      !!el;
        !!HE(heroId):A2/(ART_RING_OF_VITALITY)/?y99/?(ringA:y) A2/(ART_RING_OF_LIFE)/?y99/?(ringB:y) A2/(ART_VIAL_OF_LIFEBLOOD)/?y99/?(vial:y);
        !!VR(ringA):F0/1;
        !!VR(ringB):F0/1;
        !!VR(vial):F0/1;
        !!VR(bonus:y):S(vial) *2 +(ringA) +(ringB);
      !!en;

      !!if&(bonus)>0;
        !!VR(bonus):*5;
        !!VR(newHp:e):Sh :100 *(bonus);
        !!VR(newHpY:y):S(newHp);
        !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EBX)/4/(newHpY);
      !!en;
    !!en;
  !!el;
    !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EBX)/4/0;
  !!en;
