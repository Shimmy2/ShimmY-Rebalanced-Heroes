!?FU(OnStartOrLoad);
!!SN:L^EraPlugins\erm_hooker.era^/?y1;

!!if&y1<>0;
  !!SN:Ay1/^SetHook^/?y2;
  !!SN&y2:Ey2/1/4474597/(shimy_CastFireShieldSpell); 004446E5
!!en;

!?FU(shimy_CastFireShieldSpell);
!!UN:Cx1/(STRUCT_HOOK_CONTEXT_ECX)/4/?(spellId:y);
!!UN:Cx1/(STRUCT_HOOK_CONTEXT_EBP)/4/?(ebp:y) C(ebp)/8/4/?(spellId:y);
!!if&(spellId)=(SPELL_FIRE_SHIELD);
  !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EBP)/4/?(ebp:y) C(ebp)/20/4/?(hero:y);
  !!if&(hero);
    !!UN:C(hero)/26/4/?(heroId:y);

    !!HE(heroId):X?(specType:y)/?(specSkill:y);
    !!if&(specType)=3/(specSkill)=(SPELL_FIRE_SHIELD);
      !!HE(heroId):Ed/?(heroLevel:y);
      !!UN:Cx1/(STRUCT_HOOK_CONTEXT_ESI)/4/?(esi:y);
      !!UN:C(esi)/120/4/?(monLevel:y);
      !!VR(monLevel):+1;
      !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EDI)/4/?(currentEffect:y);
      !!VR(bonus:y):S(heroLevel)*(currentEffect)*10:(monLevel):100+(currentEffect) F1/100;
      !!if&(bonus)>(currentEffect);
        !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EDI)/4/(bonus:y);
      !!en;
    !!en;
  !!en;
!!en;
